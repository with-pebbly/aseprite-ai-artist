{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "aseprite-ai-artist",
  "displayName": "Aseprite AI Artist",
  "version": "0.1.2",
  "description": "Draw pixel art in a live Aseprite window. An MCP server with a deliberately small tool surface, an encoded pixel-art rulebook, /pixel-* workflows and review/palette/rig/animation subagents. The same skills are served over MCP, so Codex, Gemini CLI and Cursor get them too.",
  "author": {
    "name": "with-pebbly",
    "url": "https://github.com/with-pebbly"
  },
  "homepage": "https://github.com/with-pebbly/aseprite-ai-artist#readme",
  "repository": "https://github.com/with-pebbly/aseprite-ai-artist",
  "license": "MIT",
  "keywords": [
    "aseprite",
    "pixel-art",
    "sprites",
    "animation",
    "gamedev",
    "mcp"
  ],
  "mcpServers": {
    "aseprite": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/aseprite-ai-artist.mjs",
        "serve"
      ],
      "env": {
        "ASEPRITE_AI_PLUGIN_PORT": "9931",
        "ASEPRITE_AI_CONTROL_PORT": "9932"
      }
    }
  },
  "hooks": "./hooks/hooks.json"
}
